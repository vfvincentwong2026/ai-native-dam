# ─── Core ───────────────────────────────────────────────────
APP_SECRET=change-me-openssl-rand-base64-32
JWT_SECRET=change-me-openssl-rand-base64-32
BASE_URL=http://localhost:3000

# ─── Database (Postgres) ────────────────────────────────────
POSTGRES_USER=dam
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dam
DATABASE_URL=postgres://dam:change-me@localhost:5432/dam

# ─── Object Storage (S3-compatible: MinIO / R2 / S3) ────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dam-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ─── MCP Gateway ────────────────────────────────────────────
MCP_PORT=8080
# JSON map: token → principal. The Builder Runtime runs on a narrow
# Build-scope token (ADR 0010 Q2): exactly the five whitelisted tools.
DAM_TOKENS={"dev-token":{"id":"dev","scopes":["Suggest","Read","Edit"]},"builder-token":{"id":"builder-runtime","scopes":["Build"]}}

# ─── A2A (Phase 3+) ─────────────────────────────────────────
A2A_ENABLED=false
A2A_AGENT_NAME=ai-native-dam
A2A_AGENT_VERSION=0.1.0

# ─── Model Router (OpenSquilla) ─────────────────────────────
ROUTER_BASE_URL=http://localhost:4000
ROUTER_API_KEY=

# ─── Model Router (OpenAI-compatible egress for pnpm build:real) ─
# Any OpenAI chat-completions endpoint: OpenRouter, DeepSeek, local Ollama…
MODEL_ROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_ROUTER_API_KEY=
# Optional: concrete model per tier (default openai/gpt-4o-mini for all)
#MODEL_TIER_C0=openai/gpt-4o-mini
#MODEL_TIER_C1=openai/gpt-4o-mini
#MODEL_TIER_C2=openai/gpt-4o-mini
#MODEL_TIER_C3=openai/gpt-4o-mini
# Optional: run-level budget breakers (defaults 25 calls / 200k tokens)
#MODEL_RUN_MAX_CALLS=25
#MODEL_RUN_MAX_TOKENS=200000

# ─── Connectors (Phase 1+) ──────────────────────────────────
REDFOX_API_KEY=
ONEAPI_API_KEY=
