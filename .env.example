# ─── Core ───────────────────────────────────────────────────
APP_SECRET=change-me-openssl-rand-base64-32
JWT_SECRET=change-me-openssl-rand-base64-32
BASE_URL=http://localhost:3000

# ─── Database (Postgres) ────────────────────────────────────
POSTGRES_USER=dam
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dam
DATABASE_URL=postgres://dam:change-me@localhost:5432/dam

# ─── Object Storage (S3-compatible: MinIO / R2 / S3) ────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dam-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ─── MCP Gateway ────────────────────────────────────────────
MCP_PORT=8080
DAM_TOKEN=change-me-agent-token

# ─── A2A (Phase 3+) ─────────────────────────────────────────
A2A_ENABLED=false
A2A_AGENT_NAME=ai-native-dam
A2A_AGENT_VERSION=0.1.0

# ─── Model Router (OpenSquilla) ─────────────────────────────
ROUTER_BASE_URL=http://localhost:4000
ROUTER_API_KEY=

# ─── Connectors (Phase 1+) ──────────────────────────────────
REDFOX_API_KEY=
ONEAPI_API_KEY=
